# This repository is intentionally allowlist-based.
# Everything stays local unless explicitly listed below.
/*

# Repository essentials
!/.gitattributes
!/.gitignore
!/README.md
!/requirements.txt
!/LICENSE
!/CITATION.cff

# Complete Meta-FAN method and its single runnable entry point
!/run_metafan.py
!/model/
!/utils/

model/*
!model/__init__.py
!model/lstm.py
!model/meta_fan.py
!model/maml.py

utils/*
!utils/__init__.py
!utils/data.py
!utils/descriptors.py
!utils/loss.py
!utils/seed.py
!utils/training.py

# Never publish generated Python artifacts.
__pycache__/
*.py[cod]
